+/// Validate alpha before changing RGB, then replay it without retaining a full alpha plane.
+/// The input is immutable, so the second decoder sees exactly the validated byte sequence.
+fn merge_jpeg_alpha_reusing_rgb(rgb: &mut Vec<u8>, alpha: &[u8]) -> Result<bool, Error> {
+    let pixels = rgb.len() / 3;
+    let mut scratch = [0u8; 4096];
+    let mut decoder = flate2::bufread::ZlibDecoder::new(alpha);
+    let mut count = 0usize;
+    loop {
+        match decoder.read(&mut scratch) {
+            Ok(0) => break,
+            Ok(n) => count = count.saturating_add(n),
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(e) => return Err(Error::InvalidZlibCompression(e)),
+        }
+    }
+    drop(decoder);
+    if count != pixels { return Ok(false); }
+    // validate_size already bounds decoded dimensions. Keep the helper defensive as well.
+    let Some(rgba_len) = pixels.checked_mul(4) else { return Err(Error::TooLarge); };
+    rgb.reserve_exact(rgba_len.saturating_sub(rgb.len()));
+    rgb.resize(rgba_len, 0);
+    for i in (0..pixels).rev() {
+        let value = [rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]];
+        rgb[i * 4..i * 4 + 3].copy_from_slice(&value);
+    }
+    let mut decoder = flate2::bufread::ZlibDecoder::new(alpha);
+    let mut offset = 0;
+    while offset < pixels {
+        let n = (pixels - offset).min(scratch.len());
+        decoder.read_exact(&mut scratch[..n]).map_err(Error::InvalidZlibCompression)?;
+        for (rgba, &a) in rgb[offset * 4..(offset + n) * 4].chunks_exact_mut(4).zip(&scratch[..n]) {
+            rgba[0] = rgba[0].min(a);
+            rgba[1] = rgba[1].min(a);
+            rgba[2] = rgba[2].min(a);
+            rgba[3] = a;
+        }
+        offset += n;
+    }
+    drop(decoder);
+    rgb.shrink_to_fit();
+    Ok(true)
+}
