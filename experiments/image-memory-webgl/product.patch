+#[cfg(test)]
+mod memory_alpha_tests {
+    use super::*;
+    use std::io::Write;
+    fn compressed(bytes: &[u8]) -> Vec<u8> {
+        let mut e = flate2::write::ZlibEncoder::new(Vec::new(), flate2::Compression::default());
+        e.write_all(bytes).expect("compress"); e.finish().expect("finish")
+    }
+    #[test]
+    fn reuse_matches_original_with_tails_and_spare_capacity() {
+        for pixels in [0, 1, 2, 7, 4095, 4096, 4097, 262144] {
+            for tail in 0..3 { for extra in [0, 32, pixels * 3] {
+                let input: Vec<u8> = (0..pixels * 3 + tail).map(|i| (i % 251) as u8).collect();
+                let alpha: Vec<u8> = (0..pixels).map(|i| (i % 256) as u8).collect();
+                let expected: Vec<u8> = input.chunks_exact(3).zip(&alpha).flat_map(|(p, &a)| [p[0].min(a),p[1].min(a),p[2].min(a),a]).collect();
+                let mut actual=Vec::with_capacity(input.len()+extra);actual.extend_from_slice(&input);
+                assert!(merge_jpeg_alpha_reusing_rgb(&mut actual,&compressed(&alpha)).expect("valid"));
+                assert_eq!(actual,expected);
+            }}
+        }
+    }
+    #[test]
+    fn invalid_alpha_preserves_rgb_and_error() {
+        let rgb = vec![7u8; 30];
+        for n in [0, 9, 11, 10000] {
+            let mut actual=rgb.clone();
+            assert!(!merge_jpeg_alpha_reusing_rgb(&mut actual,&compressed(&vec![3;n])).expect("length mismatch"));
+            assert_eq!(actual,rgb);
+        }
+        for bytes in [&b"invalid"[..], &b"\x78\x9c\x01"[..]] {
+            let mut actual=rgb.clone();
+            let baseline=decompress_zlib(bytes);
+            let candidate=merge_jpeg_alpha_reusing_rgb(&mut actual,bytes);
+            match baseline { Err(e)=>assert_eq!(format!("{e:?}"),format!("{:?}",candidate.expect_err("same error"))),Ok(v)=>assert_eq!(candidate.expect("same success"),v.len()==10) }
+            assert_eq!(actual,rgb);
+        }
+    }
+}
