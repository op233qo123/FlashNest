+#[cfg(test)]
+mod render_cache_tests {
+    use super::*;
+    use flate2::{Compression, write::ZlibEncoder};
+    use ruffle_render::backend::{ViewportDimensions, null::NullRenderer};
+    use std::{borrow::Cow, io::Write, sync::Arc};
+
+    #[test]
+    fn bitmap_cache_release_preserves_live_handles_and_recreates() {
+        let pixels = [255, 20, 40, 60]; // SWF lossless ARGB
+        let mut encoder = ZlibEncoder::new(Vec::new(), Compression::default());
+        encoder.write_all(&pixels).unwrap();
+        let bitmap = BitmapCharacter::new(CompressedBitmap::Lossless(DefineBitsLossless {
+            version: 2,
+            id: 1,
+            format: swf::BitmapFormat::Rgb32,
+            width: 1,
+            height: 1,
+            data: Cow::Owned(encoder.finish().unwrap()),
+        }));
+        let mut renderer = NullRenderer::new(ViewportDimensions {
+            width: 1,
+            height: 1,
+            scale_factor: 1.0,
+        });
+        let decoded_before = bitmap.compressed().decode().unwrap();
+        let first = bitmap.bitmap_handle(&mut renderer).unwrap();
+        let old_weak = Arc::downgrade(&first.0);
+        assert_eq!(first, bitmap.bitmap_handle(&mut renderer).unwrap());
+        bitmap.release_render_cache();
+        bitmap.release_render_cache(); // repeated unload is harmless
+        assert!(old_weak.upgrade().is_some()); // command/live owner remains valid
+        let second = bitmap.bitmap_handle(&mut renderer).unwrap();
+        assert_ne!(first, second);
+        drop(first);
+        assert!(old_weak.upgrade().is_none());
+        assert_eq!(
+            decoded_before.data(),
+            bitmap.compressed().decode().unwrap().data()
+        );
+        let new_weak = Arc::downgrade(&second.0);
+        drop(second);
+        assert!(new_weak.upgrade().is_some()); // cached until next release
+        bitmap.release_render_cache();
+        assert!(new_weak.upgrade().is_none());
+        assert_eq!(bitmap.compressed().size().width, 1);
+    }
+}
